{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saif-portfolio-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://metasaif.github.io",
    "TURNSTILE_HOSTNAME": "metasaif.github.io"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "saif-portfolio-inquiries",
    "database_id": "07c933dd-c441-4173-bc9b-4d1e60829ee2",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    {"name":"INQUIRY_LIMITER","namespace_id":"1001","simple":{"limit":5,"period":60}},
    {"name":"ADMIN_LIMITER","namespace_id":"1002","simple":{"limit":60,"period":60}}
  ],
  "observability": {"enabled": false}
}
